# Required for core API requests and application-side encryption.
# NEXT_PUBLIC_* values are included in the browser bundle; never put a
# server-only secret in them.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SECRET_KEY=
NEXT_PUBLIC_ENCRYPTION_KEY=

# Optional public URL overrides. Built-in production defaults are used when
# these are empty.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MENU_URL=
NEXT_PUBLIC_SITEMAP_MENU_URL=

# Optional authentication providers. Google accepts either variable name.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_AUTH_URL=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Optional external-service integrations. Their related features are
# unavailable or use the application's fallback endpoint when left empty.
N8N_CHAT_WEBHOOK=
NEXT_PUBLIC_N8N_CHAT_WEBHOOK=
N8N_MENU_IMPORT_WEBHOOK=
N8N_SEO_WEBHOOK=
PEXELS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_KEY_PAIR=

# Optional analytics and advertising tags.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Optional production error reporting. The public DSN enables browser events;
# the server DSN may be the same project and is never exposed to the browser.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional source-map upload credentials used only during production builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional development and build controls.
NEXT_PUBLIC_DEV=
NEXT_PUBLIC_IMAGE_RESIZE_URL=
NEXT_PUBLIC_USE_ADMIN_MOCK_DATA=
ANALYZE=
